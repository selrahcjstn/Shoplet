// use prisma-8

enum UserRole {
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String             @id @onCreate(uuid())
  fullName     String
  email        String             @unique
  passwordHash String
  role         UserRole           @default(SELLER)
  status       UserStatus         @default(ACTIVE)
  createdAt    DateTime           @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt
}
