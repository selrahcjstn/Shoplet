# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# JWT (access token signing). Use a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=""
JWT_EXPIRES_IN="15m"

# Frontend origin(s) allowed to call the API (comma-separated)
CORS_ORIGIN="http://localhost:5173"
